import core

IrFieldPayload fn ir_field_payload(string mode, string object_name, string field_name, string value_name):
    return IrFieldPayload(mode, object_name, field_name, value_name)

IrFieldPayload fn ir_field_payload_none():
    return ir_field_payload("none", "", "", "")

IrFieldPayload fn ir_field_payload_read(string object_name, string field_name):
    return ir_field_payload("read", object_name, field_name, "")

IrFieldPayload fn ir_field_payload_write(string object_name, string field_name, string value_name):
    return ir_field_payload("write", object_name, field_name, value_name)

bool fn ir_field_payload_is_none(ref IrFieldPayload payload):
    return payload.mode == "none"

bool fn ir_field_payload_is_read(ref IrFieldPayload payload):
    return payload.mode == "read"

bool fn ir_field_payload_is_write(ref IrFieldPayload payload):
    return payload.mode == "write"

string fn ir_field_payload_object(ref IrFieldPayload payload):
    return payload.object_name

string fn ir_field_payload_name(ref IrFieldPayload payload):
    return payload.field_name

string fn ir_field_payload_value(ref IrFieldPayload payload):
    return payload.value_name

