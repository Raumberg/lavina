import ast
import typed_calls

// ═══════════════════════════════════════════════════════════════
//  Lavina Bootstrap Compiler — Typed Frontend Boundary
//  Bootstrap-friendly typed tree wrappers over normalized AST.
// ═══════════════════════════════════════════════════════════════

struct TypedExpr:
    string kind
    TypeNode value_type
    TypedCallTarget call_target
    TypedCallSig call_signature
    TypedClosureSig closure_signature
    int int_a
    vector[TypedExpr] children
    vector[TypedExpr] extra_children
    vector[string] names
    vector[TypeNode] types
    vector[string] capture_names
    vector[TypeNode] capture_types
    string text_a
    string text_b

TypeNode fn typed_expr_type(ref TypedExpr expr):
    return expr.value_type

TypedExpr fn typed_expr_none():
    vector[TypedExpr] empty = []
    vector[string] empty_names = []
    vector[TypeNode] empty_types = []
    return TypedExpr("none", TypeNode::None(), typed_call_target_none(), typed_call_sig_none(), typed_closure_sig_none(), 0, empty, empty, empty_names, empty_types, empty_names, empty_types, "", "")

struct ItemId:
    int value

ItemId fn item_id(int value):
    return ItemId(value)

struct BodyId:
    int value

BodyId fn body_id(int value):
    return BodyId(value)

struct TypedStmt:
    string kind
    Stmt node
    TypeNode value_type
    string text_a
    string text_b
    vector[string] names
    vector[vector[string]] name_groups
    vector[TypedExpr] exprs
    vector[TypedStmt] children

TypedStmt fn typed_stmt_none():
    vector[string] empty_names = []
    vector[vector[string]] empty_name_groups = []
    vector[TypedExpr] empty_exprs = []
    vector[TypedStmt] empty_children = []
    return TypedStmt("none", Stmt::None(), TypeNode::None(), "", "", empty_names, empty_name_groups, empty_exprs, empty_children)

struct TypedFunctionInfo:
    ItemId item_id
    BodyId body_id
    string name
    vector[Param] params
    TypeNode return_type
    vector[TypedStmt] body

struct TypedStructField:
    string name
    TypeNode field_type

struct TypedStructInfo:
    ItemId item_id
    BodyId constructor_body_id
    string name
    vector[TypedStructField] fields
    vector[Param] constructor_params
    vector[Expr] constructor_defaults
    vector[TypedStmt] constructor_body

struct TypedEnumVariant:
    string name
    vector[TypeNode] types
    vector[string] field_names

struct TypedEnumInfo:
    ItemId item_id
    string name
    vector[TypedEnumVariant] variants

struct TypedLambdaBodyInfo:
    BodyId body_id
    vector[TypedStmt] body

struct TypedProgram:
    string name
    BodyId top_level_body_id
    vector[TypedStmt] top_level
    vector[TypedFunctionInfo] functions
    vector[TypedStructInfo] structs
    vector[TypedEnumInfo] enums
    vector[TypedLambdaBodyInfo] lambda_blocks
