import ast
import backend_cpp
import intrinsics
import ir
import ir_call_support
import ir_control_flow_support
import ir_metadata_support
import typed_ast
import type_utils

struct LoweredValue:
    string name
    IrType value_type

struct IrLowerResult:
    IrModule module
    vector[string] errors

class IrLowerer:
    int temp_counter
    int block_counter
    int closure_counter
    vector[string] errors
    vector[IrBlock] active_blocks
    int current_block
    vector[IrLocal] active_locals
    hashmap[string, IrType] local_types
    hashmap[string, IrType] struct_field_types
    hashmap[string, IrType] call_return_types
    hashmap[string, vector[TypedEnumVariant]] enum_variants
    vector[vector[TypedStmt]] lambda_blocks
    vector[IrClosureDef] closure_defs
    vector[IrFunction] closure_functions
    IrType current_return_type
    vector[string] break_targets
    vector[string] continue_targets

    constructor():
        this.temp_counter = 0
        this.block_counter = 0
        this.closure_counter = 0
        this.errors = []
        this.active_blocks = []
        this.current_block = 0
        this.active_locals = []
        this.local_types = {}
        this.struct_field_types = {}
        this.call_return_types = {}
        this.enum_variants = {}
        this.lambda_blocks = []
        this.closure_defs = []
        this.closure_functions = []
        this.current_return_type = ir_void_type()
        this.break_targets = []
        this.continue_targets = []

    string fn next_temp():
        string name = "%${this.temp_counter}"
        this.temp_counter += 1
        return name

    string fn new_temp(IrType value_type):
        string name = this.next_temp()
        this.declare_local(name, value_type)
        return name

    string fn next_block_name(string prefix):
        string name = "${prefix}${this.block_counter}"
        this.block_counter += 1
        return name

    int fn create_block(string prefix):
        string name = this.next_block_name(prefix)
        vector[IrInst] instructions = []
        this.active_blocks.push(IrBlock(name, instructions, ir_term_none()))
        return this.active_blocks.len() - 1

    bool fn block_terminated(int index):
        return this.active_blocks[index].terminator.kind != "none"

    void fn emit(IrInst inst):
        ref! auto block = this.active_blocks[this.current_block]
        block.instructions.push(inst)

    void fn terminate(IrTerminator term):
        ref! auto block = this.active_blocks[this.current_block]
        block.terminator = term

    void fn switch_to(int index):
        this.current_block = index

    void fn declare_local(string name, IrType local_type):
        if this.local_types.has(name):
            return
        this.local_types[name] = local_type
        this.active_locals.push(IrLocal(name, local_type))

    IrType fn lower_type(ref TypeNode t):
        match t:
            Void():
                return ir_void_type()
            Bool():
                return ir_bool_type()
            Int():
                return ir_int_type()
            Int8():
                return ir_int8_type()
            Int16():
                return ir_int16_type()
            Int32():
                return ir_int32_type()
            USize():
                return ir_usize_type()
            Float():
                return ir_float_type()
            Float32():
                return ir_float32_type()
            Str():
                return ir_string_type()
            Bytes():
                return ir_bytes_type()
            Auto():
                return ir_auto_type()
            NullType():
                return ir_nullable_type(ir_auto_type())
            CString():
                return ir_cstring_type()
            Ptr(inner):
                return ir_ptr_type(this.lower_type(inner))
            Nullable(inner):
                return ir_nullable_type(this.lower_type(inner))
            Array(inner):
                return ir_array_type(this.lower_type(inner))
            HashSet(inner):
                return ir_set_type(this.lower_type(inner))
            HashMap(key_type, value_type):
                return ir_map_type(this.lower_type(key_type), this.lower_type(value_type))
            Custom(name, type_args):
                if name == "__closure":
                    return ir_generic_closure_type()
                if type_args.len() == 0:
                    return ir_type(name)
                vector[string] parts = []
                for ref arg in type_args:
                    parts.push(ir_type_to_string(this.lower_type(arg)))
                return ir_type("${name}<${parts.join(", ")}>")
            None():
                return ir_auto_type()

    IrType fn infer_binary_type(ref LoweredValue left, ref Token op, ref LoweredValue right):
        if op.token_type == TK_EQUAL_EQUAL or op.token_type == TK_BANG_EQUAL or op.token_type == TK_LESS or op.token_type == TK_LESS_EQUAL or op.token_type == TK_GREATER or op.token_type == TK_GREATER_EQUAL or op.token_type == TK_AND or op.token_type == TK_OR:
            return ir_bool_type()
        if ir_type_is_string(left.value_type) or ir_type_is_string(right.value_type):
            return ir_string_type()
        if ir_type_is_float(left.value_type) or ir_type_is_float(right.value_type):
            return ir_float_type()
        if ir_type_is_auto(left.value_type) and not ir_type_is_auto(right.value_type):
            return right.value_type
        if ir_type_is_auto(right.value_type) and not ir_type_is_auto(left.value_type):
            return left.value_type
        return left.value_type

    string fn next_closure_name():
        string name = "__closure_${this.closure_counter}"
        this.closure_counter += 1
        return name

    string fn next_closure_helper_name():
        string name = "__closure_fn_${this.closure_counter}"
        this.closure_counter += 1
        return name

    IrCallSig fn lower_typed_call_signature(ref TypedExpr expr):
        vector[IrType] param_types = []
        for ref param_type in expr.call_signature.param_types:
            param_types.push(this.lower_type(param_type))
        return ir_call_sig_from_lowered_types(param_types, this.lower_type(expr.call_signature.return_type))

    IrClosureSig fn lower_typed_closure_signature(ref TypedExpr expr):
        vector[IrType] param_types = []
        for ref param_type in expr.closure_signature.param_types:
            param_types.push(this.lower_type(param_type))
        return ir_closure_sig_from_lowered_types(param_types, this.lower_type(expr.closure_signature.return_type))

    IrCallTarget fn lower_typed_call_target(ref TypedExpr expr):
        IrCallSig signature = this.lower_typed_call_signature(expr)
        return ir_call_target_from_typed(expr.call_target, signature)

    vector[string] fn lower_call_args(ref TypedExpr expr):
        vector[string] lowered_args = []
        for ref arg in expr.children:
            auto lowered_arg = this.lower_expr(arg)
            lowered_args.push(lowered_arg.name)
        return lowered_args

    LoweredValue fn lower_call_expr(ref TypedExpr expr):
        vector[string] lowered_args = this.lower_call_args(expr)
        IrCallTarget call_target = this.lower_typed_call_target(expr)
        IrType result_type = this.lower_type(expr.value_type)
        result_type = ir_resolve_call_result_type(result_type, this.call_return_types, expr.call_target.lowered_name, this.current_return_type)
        if ir_type_has_auto(result_type):
            string dest = this.next_temp()
            this.emit(ir_call_auto(dest, call_target, lowered_args))
            return LoweredValue(dest, ir_auto_type())
        string dest = this.new_temp(result_type)
        this.emit(ir_call(dest, result_type, call_target, lowered_args))
        return LoweredValue(dest, result_type)

    vector[string] fn lower_vector_elements_with_hint(ref vector[TypedExpr] elements, ref IrType element_hint):
        vector[string] lowered_elements = []
        for ref element in elements:
            if element.kind == "vector" and element.children.len() == 0 and not ir_type_is_auto(element_hint):
                string empty_name = this.new_temp(element_hint)
                vector[string] empty_items = []
                this.emit(ir_vector_literal(empty_name, element_hint, empty_items))
                lowered_elements.push(empty_name)
            else:
                auto lowered_element = this.lower_expr(element)
                lowered_elements.push(lowered_element.name)
        return lowered_elements

    void fn lower_named_binding_init(string binding_name, IrType declared_type, ref TypedExpr value_expr):
        if value_expr.kind == "lambda" or value_expr.kind == "block_lambda":
            this.lower_closure_expr(value_expr, binding_name)
        elif ir_type_is_auto(declared_type) and value_expr.kind == "call":
            vector[string] lowered_args = this.lower_call_args(value_expr)
            IrCallTarget call_target = this.lower_typed_call_target(value_expr)
            ir_emit_call_auto_named(this.active_blocks[this.current_block].instructions, binding_name, value_expr, lowered_args, call_target)
        elif value_expr.kind == "vector":
            this.declare_local(binding_name, declared_type)
            IrType element_hint = ir_element_type_of(declared_type)
            vector[string] lowered_elements = this.lower_vector_elements_with_hint(value_expr.children, element_hint)
            ir_emit_named_vector_literal(this.active_blocks[this.current_block].instructions, binding_name, declared_type, lowered_elements)
        elif value_expr.kind == "map":
            this.declare_local(binding_name, declared_type)
            vector[string] lowered_items = []
            for i in 0..value_expr.children.len():
                auto lowered_key = this.lower_expr(value_expr.children[i])
                auto lowered_value = this.lower_expr(value_expr.extra_children[i])
                lowered_items.push(lowered_key.name)
                lowered_items.push(lowered_value.name)
            ir_emit_named_map_literal(this.active_blocks[this.current_block].instructions, binding_name, declared_type, lowered_items)
        else:
            this.declare_local(binding_name, declared_type)
            auto lowered_value = this.lower_expr(value_expr)
            this.emit(ir_move(binding_name, declared_type, lowered_value.name))

    vector[IrParam] fn closure_capture_params(ref TypedExpr expr):
        vector[IrType] types = []
        for i in 0..expr.capture_names.len():
            if i < expr.closure_signature.capture_types.len():
                types.push(this.lower_type(expr.closure_signature.capture_types[i]))
        return ir_params_from_names_and_types(expr.capture_names, types)

    vector[IrParam] fn closure_lambda_params(ref TypedExpr expr):
        vector[IrType] types = []
        for i in 0..expr.names.len():
            if i < expr.closure_signature.param_types.len():
                types.push(this.lower_type(expr.closure_signature.param_types[i]))
        return ir_params_from_names_and_types(expr.names, types)

    void fn reset_function_state():
        this.active_blocks = []
        this.active_locals = []
        this.local_types = {}
        this.break_targets = []
        this.continue_targets = []

    IrFunction fn lower_closure_helper_expr(string helper_name, ref TypedExpr expr, ref vector[IrParam] capture_params, ref vector[IrParam] lambda_params):
        vector[IrBlock] saved_blocks = this.active_blocks
        int saved_current_block = this.current_block
        vector[IrLocal] saved_locals = this.active_locals
        hashmap[string, IrType] saved_local_types = this.local_types
        vector[string] saved_break_targets = this.break_targets
        vector[string] saved_continue_targets = this.continue_targets
        IrType saved_return_type = this.current_return_type

        this.reset_function_state()
        this.current_return_type = this.lower_type(expr.closure_signature.return_type)
        vector[IrParam] helper_params = []
        int entry_index = this.create_block("bb")
        this.switch_to(entry_index)
        for ref param in capture_params:
            helper_params.push(param)
            this.declare_local(param.name, param.param_type)
        for ref param in lambda_params:
            helper_params.push(param)
            this.declare_local(param.name, param.param_type)
        auto lowered_body = this.lower_expr(expr.children[0])
        this.terminate(ir_term_return_value(lowered_body.name))
        IrFunction helper_fn = IrFunction(helper_name, helper_params, this.current_return_type, this.active_locals, this.active_blocks, false, false)

        this.active_blocks = saved_blocks
        this.current_block = saved_current_block
        this.active_locals = saved_locals
        this.local_types = saved_local_types
        this.break_targets = saved_break_targets
        this.continue_targets = saved_continue_targets
        this.current_return_type = saved_return_type
        return helper_fn

    IrFunction fn lower_closure_helper_block(string helper_name, ref TypedExpr expr, ref vector[IrParam] capture_params, ref vector[IrParam] lambda_params):
        vector[IrBlock] saved_blocks = this.active_blocks
        int saved_current_block = this.current_block
        vector[IrLocal] saved_locals = this.active_locals
        hashmap[string, IrType] saved_local_types = this.local_types
        vector[string] saved_break_targets = this.break_targets
        vector[string] saved_continue_targets = this.continue_targets
        IrType saved_return_type = this.current_return_type

        this.reset_function_state()
        vector[TypedStmt] body = []
        if expr.int_a >= 0 and expr.int_a < this.lambda_blocks.len():
            body = this.lambda_blocks[expr.int_a]
        this.current_return_type = this.lower_type(expr.closure_signature.return_type)
        vector[IrParam] helper_params = []
        int entry_index = this.create_block("bb")
        this.switch_to(entry_index)
        for ref param in capture_params:
            helper_params.push(param)
            this.declare_local(param.name, param.param_type)
        for ref param in lambda_params:
            helper_params.push(param)
            this.declare_local(param.name, param.param_type)
        for ref stmt in body:
            if this.block_terminated(this.current_block):
                break
            this.lower_stmt(stmt)
        if not this.block_terminated(this.current_block):
            if ir_type_is_void(this.current_return_type):
                this.terminate(ir_term_return_void())
            else:
                this.terminate(ir_term_unreachable())
        IrFunction helper_fn = IrFunction(helper_name, helper_params, this.current_return_type, this.active_locals, this.active_blocks, false, false)

        this.active_blocks = saved_blocks
        this.current_block = saved_current_block
        this.active_locals = saved_locals
        this.local_types = saved_local_types
        this.break_targets = saved_break_targets
        this.continue_targets = saved_continue_targets
        this.current_return_type = saved_return_type
        return helper_fn

    LoweredValue fn lower_closure_expr(ref TypedExpr expr, string preferred_name):
        string closure_name = this.next_closure_name()
        IrType closure_type = ir_closure_type(closure_name)
        string helper_name = this.next_closure_helper_name()
        vector[IrParam] capture_params = this.closure_capture_params(expr)
        vector[IrParam] lambda_params = this.closure_lambda_params(expr)
        IrFunction helper_fn
        if expr.kind == "lambda":
            helper_fn = this.lower_closure_helper_expr(helper_name, expr, capture_params, lambda_params)
        else:
            helper_fn = this.lower_closure_helper_block(helper_name, expr, capture_params, lambda_params)
        this.closure_functions.push(helper_fn)
        this.closure_defs.push(IrClosureDef(closure_name, helper_name, capture_params, lambda_params, this.lower_typed_closure_signature(expr)))
        vector[string] captures = ir_capture_names(expr)
        string dest = preferred_name
        if dest == "":
            dest = this.next_temp()
        this.emit(ir_make_closure(dest, closure_type, closure_name, captures))
        return LoweredValue(dest, closure_type)

    LoweredValue fn emit_temp_value(IrType result_type, string text_a, string text_b, string text_c, string kind):
        string dest = this.new_temp(result_type)
        if kind == "unary":
            this.emit(ir_unary(dest, result_type, text_a, text_b))
        elif kind == "get":
            this.emit(ir_get_field(dest, result_type, text_a, text_b))
        elif kind == "index":
            this.emit(ir_index(dest, result_type, text_a, text_b))
        elif kind == "cast":
            this.emit(ir_convert(dest, result_type, text_a))
        return LoweredValue(dest, result_type)

    LoweredValue fn emit_named_move_value(string dest_name, IrType result_type, string source_name):
        this.declare_local(dest_name, result_type)
        this.emit(ir_move(dest_name, result_type, source_name))
        return LoweredValue(dest_name, result_type)

    LoweredValue fn emit_temp_binary_value(IrType result_type, string op_name, string left_name, string right_name):
        string dest = this.new_temp(result_type)
        this.emit(ir_binary(dest, result_type, op_name, left_name, right_name))
        return LoweredValue(dest, result_type)

    LoweredValue fn emit_temp_const_value(IrType result_type, string literal_kind, string literal_value):
        string dest = this.new_temp(result_type)
        this.emit(ir_const(dest, result_type, literal_kind, literal_value))
        return LoweredValue(dest, result_type)

    LoweredValue fn emit_temp_vector_literal_value(IrType result_type, ref vector[string] lowered_elements):
        string dest = this.new_temp(result_type)
        this.emit(ir_vector_literal(dest, result_type, lowered_elements))
        return LoweredValue(dest, result_type)

    LoweredValue fn emit_temp_map_literal_value(IrType result_type, ref vector[string] lowered_items):
        string dest = this.new_temp(result_type)
        this.emit(ir_map_literal(dest, result_type, lowered_items))
        return LoweredValue(dest, result_type)

    LoweredValue fn lower_expr(ref TypedExpr expr):
        if expr.kind == "literal":
            IrType lowered_type = this.lower_type(expr.value_type)
            return this.emit_temp_const_value(lowered_type, expr.text_a, expr.text_b)
        elif expr.kind == "variable":
            IrType lowered_type = this.lower_type(expr.value_type)
            if this.local_types.has(expr.text_a):
                return LoweredValue(expr.text_a, this.local_types[expr.text_a])
            return LoweredValue(expr.text_a, lowered_type)
        elif expr.kind == "assign":
            auto lowered_value = this.lower_expr(expr.children[0])
            IrType result_type = this.lower_type(expr.value_type)
            if ir_type_is_auto(result_type):
                result_type = lowered_value.value_type
            return this.emit_named_move_value(expr.text_a, result_type, lowered_value.name)
        elif expr.kind == "unary":
            auto lowered_right = this.lower_expr(expr.children[0])
            IrType result_type = this.lower_type(expr.value_type)
            if ir_type_is_auto(result_type):
                result_type = lowered_right.value_type
            return this.emit_temp_value(result_type, expr.text_a, lowered_right.name, "", "unary")
        elif expr.kind == "binary":
            auto lowered_left = this.lower_expr(expr.children[0])
            auto lowered_right = this.lower_expr(expr.children[1])
            IrType result_type = this.lower_type(expr.value_type)
            if ir_type_is_auto(result_type):
                Token fake_op = Token(TK_PLUS, expr.text_a, 0, 0)
                result_type = this.infer_binary_type(lowered_left, fake_op, lowered_right)
            return this.emit_temp_binary_value(result_type, expr.text_a, lowered_left.name, lowered_right.name)
        elif expr.kind == "logical":
            auto lowered_left = this.lower_expr(expr.children[0])
            auto lowered_right = this.lower_expr(expr.children[1])
            return this.emit_temp_binary_value(ir_bool_type(), expr.text_a, lowered_left.name, lowered_right.name)
        elif expr.kind == "grouping":
            return this.lower_expr(expr.children[0])
        elif expr.kind == "call":
            return this.lower_call_expr(expr)
        elif expr.kind == "get":
            auto lowered_object = this.lower_expr(expr.children[0])
            IrType result_type = this.lower_type(expr.value_type)
            result_type = ir_struct_field_result_type(result_type, this.struct_field_types, lowered_object.value_type, expr.text_a)
            return this.emit_temp_value(result_type, lowered_object.name, expr.text_a, "", "get")
        elif expr.kind == "index":
            auto lowered_object = this.lower_expr(expr.children[0])
            auto lowered_index = this.lower_expr(expr.children[1])
            IrType result_type = this.lower_type(expr.value_type)
            if ir_type_is_auto(result_type):
                result_type = ir_element_type_of(lowered_object.value_type)
            return this.emit_temp_value(result_type, lowered_object.name, lowered_index.name, "", "index")
        elif expr.kind == "index_set":
            auto lowered_object = this.lower_expr(expr.children[0])
            auto lowered_index = this.lower_expr(expr.children[1])
            auto lowered_value = this.lower_expr(expr.children[2])
            this.emit(ir_index_set(lowered_object.name, lowered_index.name, lowered_value.name))
            return lowered_value
        elif expr.kind == "vector":
            IrType result_type = this.lower_type(expr.value_type)
            if ir_type_is_auto(result_type):
                result_type = ir_array_type(ir_auto_type())
            vector[string] lowered_elements = []
            vector[LoweredValue] lowered_values = []
            if expr.children.len() > 0:
                for ref element in expr.children:
                    if element.kind == "vector" and element.children.len() == 0:
                        lowered_values.push(LoweredValue("", ir_array_type(ir_auto_type())))
                    else:
                        lowered_values.push(this.lower_expr(element))
                IrType element_type = ir_element_type_of(result_type)
                if ir_type_is_auto(element_type):
                    for ref lowered_value in lowered_values:
                        if not ir_type_is_array_of_auto(lowered_value.value_type) and not ir_type_is_auto(lowered_value.value_type):
                            element_type = lowered_value.value_type
                if ir_type_is_array_of_auto(result_type):
                    result_type = ir_array_type(element_type)
                for ref lowered_value in lowered_values:
                    if lowered_value.name == "":
                        string empty_name = this.new_temp(element_type)
                        vector[string] empty_items = []
                        this.emit(ir_vector_literal(empty_name, element_type, empty_items))
                        lowered_elements.push(empty_name)
                    else:
                        lowered_elements.push(lowered_value.name)
            return this.emit_temp_vector_literal_value(result_type, lowered_elements)
        elif expr.kind == "map":
            IrType result_type = this.lower_type(expr.value_type)
            if ir_type_is_auto(result_type):
                result_type = ir_map_type(ir_auto_type(), ir_auto_type())
            vector[string] lowered_items = []
            if expr.children.len() > 0:
                auto first_key = this.lower_expr(expr.children[0])
                auto first_value = this.lower_expr(expr.extra_children[0])
                if ir_type_is_map_of_auto(result_type):
                    result_type = ir_map_type(first_key.value_type, first_value.value_type)
                lowered_items.push(first_key.name)
                lowered_items.push(first_value.name)
                for i in 1..expr.children.len():
                    auto lowered_key = this.lower_expr(expr.children[i])
                    auto lowered_value = this.lower_expr(expr.extra_children[i])
                    lowered_items.push(lowered_key.name)
                    lowered_items.push(lowered_value.name)
            return this.emit_temp_map_literal_value(result_type, lowered_items)
        elif expr.kind == "set":
            auto lowered_value = this.lower_expr(expr.children[1])
            if expr.children[0].kind == "variable":
                this.emit(ir_set_field(expr.children[0].text_a, expr.text_a, lowered_value.name))
                return lowered_value
            this.errors.push("Unsupported set target in IR lowering")
            return lowered_value
        elif expr.kind == "cast":
            auto lowered_value = this.lower_expr(expr.children[0])
            IrType result_type = this.lower_type(expr.value_type)
            return this.emit_temp_value(result_type, lowered_value.name, "", "", "cast")
        elif expr.kind == "lambda" or expr.kind == "block_lambda":
            return this.lower_closure_expr(expr, "")
        this.errors.push("Unsupported typed expression in IR lowering: ${expr.kind}")
        return this.emit_temp_const_value(ir_auto_type(), "error", "\"unsupported_expr\"")

    void fn lower_stmt(ref TypedStmt stmt):
        if stmt.kind == "none":
            return
        elif stmt.kind == "expr_stmt":
            if stmt.exprs.len() == 0:
                return
            if stmt.exprs[0].kind == "call":
                vector[string] lowered_args = []
                for ref arg in stmt.exprs[0].children:
                    auto lowered_arg = this.lower_expr(arg)
                    lowered_args.push(lowered_arg.name)
                IrCallTarget call_target = this.lower_typed_call_target(stmt.exprs[0])
                ir_emit_call_void_expr(this.active_blocks[this.current_block].instructions, stmt.exprs[0], lowered_args, call_target)
            else:
                this.lower_expr(stmt.exprs[0])
        elif stmt.kind == "let":
            IrType declared_type = this.lower_type(stmt.value_type)
            if stmt.exprs.len() == 0:
                this.declare_local(stmt.text_a, declared_type)
                return
            auto initializer_expr = stmt.exprs[0]
            if initializer_expr.kind == "none":
                this.declare_local(stmt.text_a, declared_type)
                return
            this.lower_named_binding_init(stmt.text_a, declared_type, initializer_expr)
        elif stmt.kind == "const":
            IrType declared_type = this.lower_type(stmt.value_type)
            if stmt.exprs.len() == 0:
                this.declare_local(stmt.text_a, declared_type)
                return
            auto value_expr = stmt.exprs[0]
            this.lower_named_binding_init(stmt.text_a, declared_type, value_expr)
        elif stmt.kind == "return":
            if stmt.exprs.len() == 0:
                this.terminate(ir_term_return_void())
                return
            if stmt.exprs[0].kind == "none":
                this.terminate(ir_term_return_void())
            else:
                auto lowered_value = this.lower_expr(stmt.exprs[0])
                auto return_term = ir_term_return_value(lowered_value.name)
                ir_emit_return_from_exprs(return_term, stmt.exprs, lowered_value.name)
                this.terminate(return_term)
        elif stmt.kind == "block":
            for ref nested in stmt.children:
                if this.block_terminated(this.current_block):
                    return
                this.lower_stmt(nested)
        elif stmt.kind == "namespace":
            for ref nested in stmt.children:
                if this.block_terminated(this.current_block):
                    return
                this.lower_stmt(nested)
        elif stmt.kind == "if":
            auto lowered_condition = this.lower_expr(stmt.exprs[0])
            int then_index = this.create_block("bb_then")
            int else_index = this.create_block("bb_else")
            int end_index = this.create_block("bb_end")
            auto plan = ir_if_plan(this.active_blocks, then_index, else_index, end_index)
            this.terminate(ir_term_branch(lowered_condition.name, plan.then_name, plan.else_name))

            this.switch_to(plan.then_index)
            this.lower_stmt(stmt.children[0])
            if not this.block_terminated(this.current_block):
                this.terminate(ir_term_jump(plan.end_name))

            this.switch_to(plan.else_index)
            this.lower_stmt(stmt.children[1])
            if not this.block_terminated(this.current_block):
                this.terminate(ir_term_jump(plan.end_name))

            this.switch_to(plan.end_index)
        elif stmt.kind == "while":
            int cond_index = this.create_block("bb_while_cond")
            int body_index = this.create_block("bb_while_body")
            int end_index = this.create_block("bb_while_end")
            auto plan = ir_while_plan(this.active_blocks, cond_index, body_index, end_index)

            this.terminate(ir_term_jump(plan.cond_name))

            this.switch_to(plan.cond_index)
            auto lowered_condition = this.lower_expr(stmt.exprs[0])
            this.terminate(ir_term_branch(lowered_condition.name, plan.body_name, plan.end_name))

            ir_push_loop_targets(this.break_targets, this.continue_targets, plan.end_name, plan.cond_name)
            this.switch_to(plan.body_index)
            this.lower_stmt(stmt.children[0])
            if not this.block_terminated(this.current_block):
                this.terminate(ir_term_jump(plan.cond_name))
            ir_pop_loop_targets(this.break_targets, this.continue_targets)

            this.switch_to(plan.end_index)
        elif stmt.kind == "for":
            if stmt.exprs[0].kind == "range":
                string iter_name = stmt.text_a
                auto lowered_start = this.lower_expr(stmt.exprs[0].children[0])
                auto lowered_end = this.lower_expr(stmt.exprs[0].children[1])
                IrType iter_type = lowered_start.value_type
                if ir_type_is_auto(iter_type):
                    iter_type = ir_int_type()
                this.declare_local(iter_name, iter_type)
                this.emit(ir_move(iter_name, iter_type, lowered_start.name))

                int cond_index = this.create_block("bb_for_cond")
                int body_index = this.create_block("bb_for_body")
                int step_index = this.create_block("bb_for_step")
                int end_index = this.create_block("bb_for_end")
                auto plan = ir_for_plan(this.active_blocks, cond_index, body_index, step_index, end_index)

                this.terminate(ir_term_jump(plan.cond_name))

                this.switch_to(plan.cond_index)
                string cmp_name = this.new_temp(ir_bool_type())
                this.emit(ir_binary_lt(cmp_name, iter_name, lowered_end.name))
                this.terminate(ir_term_branch(cmp_name, plan.body_name, plan.end_name))

                ir_push_loop_targets(this.break_targets, this.continue_targets, plan.end_name, plan.step_name)
                this.switch_to(plan.body_index)
                this.lower_stmt(stmt.children[0])
                if not this.block_terminated(this.current_block):
                    this.terminate(ir_term_jump(plan.step_name))

                this.switch_to(plan.step_index)
                string one_name = this.new_temp(iter_type)
                this.emit(ir_const_int(one_name, iter_type, "1"))
                string next_name = this.new_temp(iter_type)
                this.emit(ir_binary_add(next_name, iter_type, iter_name, one_name))
                this.emit(ir_move(iter_name, iter_type, next_name))
                this.terminate(ir_term_jump(plan.cond_name))
                ir_pop_loop_targets(this.break_targets, this.continue_targets)

                this.switch_to(plan.end_index)
            else:
                auto collection_value = this.lower_expr(stmt.exprs[0])
                string collection_name = collection_value.name
                string index_name = "${stmt.text_a}__index"
                string item_name = stmt.text_a
                IrType index_type = ir_int_type()
                IrType item_type = ir_element_type_of(collection_value.value_type)
                if ir_type_is_auto(item_type):
                    item_type = this.lower_type(stmt.exprs[0].value_type)
                this.declare_local(index_name, index_type)
                this.declare_local(item_name, item_type)
                string zero_name = this.new_temp(index_type)
                this.emit(ir_const_int(zero_name, index_type, "0"))
                this.emit(ir_move(index_name, index_type, zero_name))

                int cond_index = this.create_block("bb_for_cond")
                int body_index = this.create_block("bb_for_body")
                int step_index = this.create_block("bb_for_step")
                int end_index = this.create_block("bb_for_end")
                auto plan = ir_for_plan(this.active_blocks, cond_index, body_index, step_index, end_index)

                this.terminate(ir_term_jump(plan.cond_name))

                this.switch_to(plan.cond_index)
                string len_name = this.new_temp(ir_int_type())
                vector[string] len_args = [collection_name]
                this.emit(ir_call(len_name, ir_int_type(), ir_len_call_target(collection_value.value_type), len_args))
                string cmp_name = this.new_temp(ir_bool_type())
                this.emit(ir_binary_lt(cmp_name, index_name, len_name))
                this.terminate(ir_term_branch(cmp_name, plan.body_name, plan.end_name))

                ir_push_loop_targets(this.break_targets, this.continue_targets, plan.end_name, plan.step_name)
                this.switch_to(plan.body_index)
                this.emit(ir_index(item_name, item_type, collection_name, index_name))
                this.lower_stmt(stmt.children[0])
                if not this.block_terminated(this.current_block):
                    this.terminate(ir_term_jump(plan.step_name))

                this.switch_to(plan.step_index)
                string one_name = this.new_temp(index_type)
                this.emit(ir_const_int(one_name, index_type, "1"))
                string next_name = this.new_temp(index_type)
                this.emit(ir_binary_add(next_name, index_type, index_name, one_name))
                this.emit(ir_move(index_name, index_type, next_name))
                this.terminate(ir_term_jump(plan.cond_name))
                ir_pop_loop_targets(this.break_targets, this.continue_targets)

                this.switch_to(plan.end_index)
        elif stmt.kind == "break":
            string target = ir_current_break_target(this.break_targets)
            if target == "":
                this.errors.push("break used outside loop")
                return
            this.terminate(ir_term_jump(target))
            int dead_index = this.create_block("bb_dead")
            this.switch_to(dead_index)
        elif stmt.kind == "continue":
            string target = ir_current_continue_target(this.continue_targets)
            if target == "":
                this.errors.push("continue used outside loop")
                return
            this.terminate(ir_term_jump(target))
            int dead_index = this.create_block("bb_dead")
            this.switch_to(dead_index)
        elif stmt.kind == "pass":
            return
        elif stmt.kind == "try":
            this.errors.push("try is not yet supported in IR lowering")
        elif stmt.kind == "match":
            auto lowered_match_value = this.lower_expr(stmt.exprs[0])
            string enum_name = ir_match_enum_name(stmt.exprs[0].value_type)
            int end_index = this.create_block("bb_match_end")
            string end_name = this.active_blocks[end_index].name
            int next_index = this.current_block
            for i in 0..stmt.children.len():
                this.switch_to(next_index)
                string pattern_name = stmt.names[i]
                int body_index = this.create_block("bb_match_arm")
                bool is_wildcard = pattern_name == "_"
                int fail_index = end_index
                if not is_wildcard and i + 1 < stmt.children.len():
                    fail_index = this.create_block("bb_match_next")
                auto arm_plan = ir_match_arm_plan(this.active_blocks, body_index, fail_index, is_wildcard)
                if is_wildcard:
                    this.terminate(ir_term_jump(arm_plan.body_name))
                else:
                    string cond_name = this.new_temp(ir_bool_type())
                    this.emit(ir_enum_is(cond_name, lowered_match_value.name, pattern_name))
                    this.terminate(ir_term_branch(cond_name, arm_plan.body_name, arm_plan.fail_name))
                this.switch_to(body_index)
                if enum_name != "":
                    auto variant = ir_enum_variant_lookup(this.enum_variants, enum_name, pattern_name)
                    for bi in 0..stmt.name_groups[i].len():
                        if bi < variant.field_names.len() and bi < variant.types.len():
                            string binding_name = stmt.name_groups[i][bi]
                            IrType binding_type = this.lower_type(variant.types[bi])
                            this.declare_local(binding_name, binding_type)
                            this.emit(ir_enum_get(binding_name, binding_type, lowered_match_value.name, pattern_name, variant.field_names[bi]))
                this.lower_stmt(stmt.children[i])
                if not this.block_terminated(this.current_block):
                    this.terminate(ir_term_jump(end_name))
                next_index = arm_plan.fail_index
            this.switch_to(end_index)
        else:
            this.errors.push("Unsupported typed statement kind in IR lowering: ${stmt.kind}")

    IrFunction fn lower_typed_function(ref TypedFunctionInfo fn_info):
        this.active_blocks = []
        this.active_locals = []
        this.local_types = {}
        this.break_targets = []
        this.continue_targets = []
        this.current_return_type = this.lower_type(fn_info.return_type)
        vector[IrParam] lowered_params = []
        int entry_index = this.create_block("bb")
        this.switch_to(entry_index)
        for ref param in fn_info.params:
            IrType param_type = this.lower_type(param.param_type)
            lowered_params.push(IrParam(param.name.lexeme, param_type))
            this.declare_local(param.name.lexeme, param_type)
        for ref body_stmt in fn_info.body:
            if this.block_terminated(this.current_block):
                break
            this.lower_stmt(body_stmt)
        if not this.block_terminated(this.current_block):
            if ir_type_is_void(this.current_return_type):
                this.terminate(ir_term_return_void())
            else:
                this.terminate(ir_term_unreachable())
        return IrFunction(fn_info.name, lowered_params, this.current_return_type, this.active_locals, this.active_blocks, fn_info.name == "main", false)

    IrLowerResult fn lower_program(ref TypedProgram program):
        this.struct_field_types = {}
        this.call_return_types = {}
        this.enum_variants = {}
        this.lambda_blocks = program.lambda_blocks
        for ref struct_info in program.structs:
            this.call_return_types[struct_info.name] = ir_type(struct_info.name)
            for ref field in struct_info.fields:
                this.struct_field_types["${struct_info.name}.${field.name}"] = this.lower_type(field.field_type)
        for ref enum_info in program.enums:
            this.call_return_types[enum_info.name] = ir_type(enum_info.name)
            this.enum_variants[enum_info.name] = enum_info.variants
            for ref variant in enum_info.variants:
                this.call_return_types["${enum_info.name}::make_${variant.name}"] = ir_type(enum_info.name)
        vector[IrFunction] functions = []
        for ref fn_info in program.functions:
            this.call_return_types[fn_info.name] = this.lower_type(fn_info.return_type)
        for ref fn_info in program.functions:
            functions.push(this.lower_typed_function(fn_info))
        if program.top_level.len() > 0:
            TypedFunctionInfo top_level_fn = TypedFunctionInfo("__module_init", [], TypeNode::Void(), program.top_level)
            functions.push(this.lower_typed_function(top_level_fn))
        vector[IrFunction] ordered_functions = []
        for ref closure_fn in this.closure_functions:
            ordered_functions.push(closure_fn)
        for ref fn_ir in functions:
            ordered_functions.push(fn_ir)
        return IrLowerResult(IrModule(program.name, this.closure_defs, ordered_functions), this.errors)

vector[string] fn lower_ir_errors(ref IrLowerResult result):
    return result.errors

IrLowerResult fn lower_to_ir(ref TypedProgram program):
    auto lowerer = IrLowerer()
    return lowerer.lower_program(program)
