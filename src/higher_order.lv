import ast
import typed_calls
import typed_ast

bool fn higher_order_types_equal(ref TypeNode left, ref TypeNode right):
    match left:
        None():
            match right:
                None():
                    return true
                _:
                    return false
        Int():
            match right:
                Int():
                    return true
                _:
                    return false
        Float():
            match right:
                Float():
                    return true
                _:
                    return false
        Str():
            match right:
                Str():
                    return true
                _:
                    return false
        Bool():
            match right:
                Bool():
                    return true
                _:
                    return false
        Void():
            match right:
                Void():
                    return true
                _:
                    return false
        Auto():
            match right:
                Auto():
                    return true
                _:
                    return false
        NullType():
            match right:
                NullType():
                    return true
                _:
                    return false
        Int8():
            match right:
                Int8():
                    return true
                _:
                    return false
        Int16():
            match right:
                Int16():
                    return true
                _:
                    return false
        Int32():
            match right:
                Int32():
                    return true
                _:
                    return false
        Float32():
            match right:
                Float32():
                    return true
                _:
                    return false
        USize():
            match right:
                USize():
                    return true
                _:
                    return false
        CString():
            match right:
                CString():
                    return true
                _:
                    return false
        Bytes():
            match right:
                Bytes():
                    return true
                _:
                    return false
        Array(left_inner):
            match right:
                Array(right_inner):
                    return higher_order_types_equal(left_inner, right_inner)
                _:
                    return false
        HashSet(left_inner):
            match right:
                HashSet(right_inner):
                    return higher_order_types_equal(left_inner, right_inner)
                _:
                    return false
        HashMap(left_key, left_value):
            match right:
                HashMap(right_key, right_value):
                    return higher_order_types_equal(left_key, right_key) and higher_order_types_equal(left_value, right_value)
                _:
                    return false
        Nullable(left_inner):
            match right:
                Nullable(right_inner):
                    return higher_order_types_equal(left_inner, right_inner)
                _:
                    return false
        Ptr(left_inner):
            match right:
                Ptr(right_inner):
                    return higher_order_types_equal(left_inner, right_inner)
                _:
                    return false
        Custom(left_name, left_args):
            match right:
                Custom(right_name, right_args):
                    if left_name != right_name or left_args.len() != right_args.len():
                        return false
                    for i in 0..left_args.len():
                        if not higher_order_types_equal(left_args[i], right_args[i]):
                            return false
                    return true
                _:
                    return false
    return false

bool fn higher_order_is_auto_type(ref TypeNode value_type):
    match value_type:
        Auto():
            return true
        _:
            return false

TypeNode fn higher_order_collection_item_type(ref TypeNode value_type):
    match value_type:
        Array(inner):
            return inner
        HashSet(inner):
            return inner
        _:
            return TypeNode::Auto()

bool fn higher_order_type_has_auto(ref TypeNode value_type):
    match value_type:
        Auto():
            return true
        Array(inner):
            return higher_order_type_has_auto(inner)
        HashSet(inner):
            return higher_order_type_has_auto(inner)
        HashMap(key_type, item_type):
            return higher_order_type_has_auto(key_type) or higher_order_type_has_auto(item_type)
        Custom(name, type_args):
            for ref arg in type_args:
                if higher_order_type_has_auto(arg):
                    return true
        Nullable(inner):
            return higher_order_type_has_auto(inner)
        Ptr(inner):
            return higher_order_type_has_auto(inner)
        _:
            pass
    return false

bool fn higher_order_closure_accepts_types(ref TypeNode closure_type, ref vector[TypeNode] expected_types):
    if not typed_is_closure_type(closure_type):
        return false
    vector[TypeNode] param_types = typed_closure_param_types(closure_type)
    if param_types.len() != expected_types.len():
        return false
    for i in 0..param_types.len():
        match param_types[i]:
            Auto():
                pass
            _:
                if not higher_order_types_equal(param_types[i], expected_types[i]):
                    return false
    return true

TypeNode fn higher_order_return_type(string target_name, ref vector[TypedExpr] args, ref TypeNode first_arg_type):
    if target_name == "__lv_col_map" and args.len() >= 2:
        TypeNode item_input = higher_order_collection_item_type(first_arg_type)
        TypeNode callback_type = typed_expr_type(args[1])
        vector[TypeNode] expected = [item_input]
        if typed_is_closure_type(callback_type):
            TypeNode item_type = typed_closure_return_type(callback_type)
            if higher_order_type_has_auto(item_type):
                return TypeNode::Auto()
            return TypeNode::Array(item_type)
        if not higher_order_is_auto_type(item_input):
            return TypeNode::Array(item_input)
        return TypeNode::Auto()
    elif target_name == "__lv_col_filter" and args.len() >= 2:
        TypeNode item_input = higher_order_collection_item_type(first_arg_type)
        TypeNode callback_type = typed_expr_type(args[1])
        vector[TypeNode] expected = [item_input]
        if typed_is_closure_type(callback_type) and (higher_order_is_auto_type(item_input) or higher_order_closure_accepts_types(callback_type, expected)):
            return first_arg_type
        if not higher_order_is_auto_type(item_input):
            return first_arg_type
        return TypeNode::Auto()
    elif target_name == "__lv_col_reduce" and args.len() >= 3:
        TypeNode item_input = higher_order_collection_item_type(first_arg_type)
        TypeNode init_type = typed_expr_type(args[2])
        TypeNode callback_type = typed_expr_type(args[1])
        vector[TypeNode] expected = [init_type, item_input]
        if typed_is_closure_type(callback_type) and (higher_order_is_auto_type(item_input) or higher_order_closure_accepts_types(callback_type, expected)):
            return init_type
        match init_type:
            Auto():
                pass
            _:
                return init_type
        return TypeNode::Auto()
    elif target_name == "__lv_col_for_each" and args.len() >= 2:
        TypeNode item_input = higher_order_collection_item_type(first_arg_type)
        TypeNode callback_type = typed_expr_type(args[1])
        vector[TypeNode] expected = [item_input]
        if typed_is_closure_type(callback_type) and (higher_order_is_auto_type(item_input) or higher_order_closure_accepts_types(callback_type, expected)):
            return TypeNode::Void()
        if not higher_order_is_auto_type(item_input):
            return TypeNode::Void()
        return TypeNode::Auto()
    return TypeNode::Auto()
