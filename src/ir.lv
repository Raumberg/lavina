IrType fn ir_call_target_return_type(ref IrCallTarget target):
    return ir_call_sig_return_type(target.signature)

vector[IrType] fn ir_call_target_param_types(ref IrCallTarget target):
    return ir_call_sig_param_types(target.signature)

IrCallPayload fn ir_call_payload(string mode, IrCallTarget target, ref vector[string] args):
