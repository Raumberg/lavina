IrCallTarget fn ir_call_target_none():
    return IrCallTarget("none", "", ir_call_sig([], ir_void_type()))

IrCallTarget fn ir_call_target_function(string name, IrCallSig signature):
    return IrCallTarget("function", name, signature)

IrCallTarget fn ir_call_target_intrinsic(string name, IrCallSig signature):
